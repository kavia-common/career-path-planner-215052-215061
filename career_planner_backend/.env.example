# Example environment configuration for Career Planner Backend
# Copy to .env and fill values (do not commit secrets)

# Supabase configuration (replace with your project settings)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL connection string (Neon/Supabase or any Postgres)
# Formats supported:
#   postgresql://user:pass@host:port/dbname
#   postgresql+psycopg2://user:pass@host:port/dbname
#   For legacy: postgres://user:pass@host:port/dbname (auto-normalized)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# CORS
CORS_ORIGINS=*
