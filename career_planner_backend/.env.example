# Copy to .env and fill in values. Do NOT commit real secrets.
# DATABASE
# IMPORTANT: Use the pure Postgres URL, not the Neon shell command.
# Example (Neon): postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Do NOT include:  psql 'postgresql://...'
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# CORS
CORS_ORIGINS=*

# Supabase (optional for JWT-protected routes; not required for /db/* endpoints)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend/backend URLs (optional; allow seed_full_cli to verify endpoints)
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_API_BASE=http://localhost:8000
