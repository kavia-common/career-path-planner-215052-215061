# Backend environment example

# PUBLIC_INTERFACE
# DATABASE_URL is required by the FastAPI backend to connect to PostgreSQL.
# Example for local/dev:
# postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/career_planner

# Optional CORS settings (list of origins). Leave empty to allow all in dev via proxy.
#BACKEND_CORS_ORIGINS=["http://localhost:3000"]
