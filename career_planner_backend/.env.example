# Backend environment configuration for Career Planner Backend (FastAPI)
# Copy this file to `.env` in the same directory and fill in the values.
# Do NOT commit your real `.env` file.

# REQUIRED: Postgres connection URL for Neon/Supabase in standard format.
# Example (Neon): DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
# Example (Supabase): DATABASE_URL=postgresql://<user>:<password>@db.<projectref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# OPTIONAL: Supabase project information for JWT profile endpoints and admin tasks.
# These are safe defaults for local dev; replace in deployed environments.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=dev-service-role-key

# CORS origins for the frontend (comma-separated). Use * to allow all during development.
CORS_ORIGINS=*

# Notes:
# - After setting DATABASE_URL, run:
#     cd career_planner_backend
#     python -m src.cli_sync_schema
#     python -m src.seed_cli
# - Verify endpoints:
#     GET /health/db
#     GET /db/users
#     GET /db/roles
#     GET /db/competencies
#
# - Optional JSON catalog seeding:
#   Place any of these files under career_planner_backend/data:
#     roles.json, competencies.json, role_adjacency.json, role_competencies.json
#   If absent, a minimal built-in catalog will be seeded.
