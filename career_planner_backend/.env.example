# Database connection string for Neon/Supabase Postgres (no quotes).
# Example: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# Supabase project (optional for DB-only direct SQL flows in this backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS origins (comma-separated or * for all)
CORS_ORIGINS=*
