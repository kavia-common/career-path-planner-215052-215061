# Backend FastAPI configuration
# PUBLIC: Provide these variables via the orchestrator. Do not commit real secrets.

# Server bind settings (backend typically runs on 3001)
HOST=0.0.0.0
PORT=3001

# Database connection
# Prefer DATABASE_URL in standard SQLAlchemy/psycopg2 format.
# Example points to the database service container "career_planner_database" on default PostgreSQL port.
# IMPORTANT: Replace user/password/dbname to match your environment.
# Syntax: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://career_user:career_password@career_planner_database:5432/career_db

# Legacy fallbacks (used only if DATABASE_URL is not set)
POSTGRES_HOST=career_planner_database
POSTGRES_PORT=5432
POSTGRES_DB=career_db
POSTGRES_USER=career_user
POSTGRES_PASSWORD=career_password
# POSTGRES_SSLMODE=disable  # Optional: e.g., require|disable

# CORS (optional) - comma separated full URLs if needed
# BACKEND_CORS_ORIGINS=https://example.com,https://localhost:3000
