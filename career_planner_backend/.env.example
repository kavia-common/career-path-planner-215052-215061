# Copy this file to .env and fill in values as appropriate.
# Only variables relevant to backend boot are listed here.

# PostgreSQL connection string for Neon/Supabase (no quotes).
# Recommended driver prefix: postgresql+psycopg2
# Example (Neon): postgresql+psycopg2://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Optional CORS origins (comma-separated) or "*" for allow-all.
CORS_ORIGINS=*

# Supabase project settings (optional for some endpoints; used for auth and REST fallbacks)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
