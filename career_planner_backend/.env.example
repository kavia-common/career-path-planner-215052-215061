# Copy this file to .env and adjust values for your environment.
# These variables are optional for local boot; defaults exist in code to allow uvicorn to start.
# For real integrations, set correct values.

# PUBLIC_INTERFACE
# SUPABASE project URL (no trailing slash)
SUPABASE_URL=https://your-project-ref.supabase.co

# PUBLIC_INTERFACE
# Supabase anon (public) key for client/user requests
SUPABASE_ANON_KEY=your-anon-key

# PUBLIC_INTERFACE
# Supabase service role key (server-side admin tasks). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PUBLIC_INTERFACE
# Optional: direct database URL if you use it elsewhere (not required for REST-only mode)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# PUBLIC_INTERFACE
# Comma-separated list of allowed origins or * to allow all (dev only).
# Example: http://localhost:3000,https://your-frontend.example.com
CORS_ORIGINS=*
