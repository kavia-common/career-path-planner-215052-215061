# PUBLIC_INTERFACE
# Backend environment variables for Career Planner (FastAPI)

# Comma-separated list of allowed origins for CORS
# e.g., http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000

# Database URL (PostgreSQL); required for direct DB endpoints and seeding.
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Supabase credentials (if using Supabase REST/auth features)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
